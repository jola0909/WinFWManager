<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinFWManager.Core\WinFWManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    GeoIP city database. Copied to the output only when present: it is ~61 MB and
    MaxMind's GeoLite2 licence does not permit redistributing it, so it is gitignored
    rather than committed. Without it the app still runs and every country reads
    "Unknown" — see the GeoIP section in README.md for how to obtain a copy.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)GeoLite2-City.mmdb')">
    <None Include="GeoLite2-City.mmdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Hosts the local MCP endpoint inside the WPF process so tools can read live UI state. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
