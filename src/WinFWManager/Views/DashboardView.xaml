<UserControl x:Class="WinFWManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary Cards -->
            <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,16">
                <!-- Total Connections -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Total Connections" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalConnections}" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Blocked -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Blocked" Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0">
                            <Run Text="{Binding BlockedConnections, Mode=OneWay}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding BlockedPercent, Mode=OneWay, StringFormat='{}{0:F1}%'}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Allowed -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Allowed" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding AllowedConnections}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Direction -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Direction" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0">
                            <Run Text="In: "/><Run Text="{Binding InboundCount, Mode=OneWay}"/>
                            <Run Text="  Out: "/><Run Text="{Binding OutboundCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Top Talkers -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Top Destinations" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopTalkers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Country}" Margin="8,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Top Blocked" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopBlocked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Country}" Margin="8,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
