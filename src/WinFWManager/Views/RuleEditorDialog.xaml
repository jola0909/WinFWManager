<Window x:Class="WinFWManager.Views.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinFWManager.Core.Models;assembly=WinFWManager.Core"
        Title="Rule Editor" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBgBrush}"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>
        <ObjectDataProvider x:Key="DirectionValues" MethodName="GetValues" ObjectType="{x:Type models:TrafficDirection}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TrafficDirection"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ActionValues" MethodName="GetValues" ObjectType="{x:Type models:TrafficAction}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TrafficAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ProtocolValues" MethodName="GetValues" ObjectType="{x:Type models:TransportProtocol}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TransportProtocol"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ProfileValues" MethodName="GetValues" ObjectType="{x:Type models:FirewallProfile}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:FirewallProfile"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- No spacer row: the window sizes to its content, so a star row would
                 collapse to nothing anyway and only obscure the layout. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Name:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="Display Name:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDisplayName" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="2" Text="Description:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDescription" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3" Text="Direction:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbDirection" ItemsSource="{Binding Source={StaticResource DirectionValues}}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="4" Text="Action:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbAction" ItemsSource="{Binding Source={StaticResource ActionValues}}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="5" Text="Protocol:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CmbProtocol" ItemsSource="{Binding Source={StaticResource ProtocolValues}}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="6" Text="Local Port:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtLocalPort" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="7" Text="Remote Port:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtRemotePort" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="8" Text="Local Addr:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtLocalAddress" Margin="0,0,0,6"
                 ToolTip="Blank means any. Accepts an address, a range, CIDR, or keywords such as LocalSubnet — comma-separate several."/>

        <TextBlock Grid.Row="9" Text="Remote Addr:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtRemoteAddress" Margin="0,0,0,6"
                 ToolTip="Blank means any. Accepts an address, a range, CIDR, or keywords such as LocalSubnet — comma-separate several."/>

        <TextBlock Grid.Row="10" Text="Program:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtProgram" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="11" Text="Profile:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="11" Grid.Column="1" x:Name="CmbProfile" ItemsSource="{Binding Source={StaticResource ProfileValues}}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="12" Text="Enabled:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <CheckBox Grid.Row="12" Grid.Column="1" x:Name="ChkEnabled" VerticalAlignment="Center" Margin="0,0,0,6"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Padding="4" Margin="0,0,8,0" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" Padding="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
