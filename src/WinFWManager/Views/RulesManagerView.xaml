<UserControl x:Class="WinFWManager.Views.RulesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBgBrush}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="New Rule" Command="{Binding NewRuleCommand}" Padding="12,4" Margin="0,0,4,0"/>
                <Button Content="Edit" Command="{Binding EditRuleCommand}" Padding="12,4" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteRuleCommand}" Padding="12,4" Margin="0,0,4,0"/>
                <Button Content="Enable/Disable" Command="{Binding ToggleEnabledCommand}" Padding="12,4" Margin="0,0,4,0"/>
                <Button Content="Refresh" Command="{Binding RefreshRulesCommand}" Padding="12,4" Margin="0,0,4,0"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,4,0"
                        ToolTip="Save the rules currently visible, with search and profile filters applied."/>
            </StackPanel>
        </Border>

        <!-- Filter Row -->
        <Border Grid.Row="1" Background="{DynamicResource TertiaryBgBrush}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Store:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding StoreValues}" SelectedItem="{Binding SelectedStore}" Width="140" Margin="0,0,8,0"/>
                <TextBlock Text="Profile:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding ProfileValues}" SelectedItem="{Binding SelectedProfile}" Width="100" Margin="0,0,8,0"
                          IsSynchronizedWithCurrentItem="False"/>
                <TextBlock Text="Search:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <CheckBox Content="Hyper-V Rules" IsChecked="{Binding ShowHyperVRules}"
                          Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                          Visibility="{Binding IsHyperVAvailable, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Rules DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding RulesView}"
                  SelectedItem="{Binding SelectedRule}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="{DynamicResource PrimaryBgBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  RowBackground="{DynamicResource PrimaryBgBrush}"
                  AlternatingRowBackground="{DynamicResource SecondaryBgBrush}"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  HeadersVisibility="Column">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="200"/>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="60"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPort}" Width="80"/>
                <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePort}" Width="80"/>
                <DataGridTextColumn Header="Local Addr" Binding="{Binding LocalAddress}" Width="120"/>
                <DataGridTextColumn Header="Remote Addr" Binding="{Binding RemoteAddress}" Width="120"/>
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="70"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="150"/>
                <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Status -->
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBgBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                    <Run Text="Rules: "/>
                    <Run Text="{Binding RuleCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
