<Window x:Class="WinFWManager.Views.McpConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Connection (MCP)" Height="440" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Connection (MCP)" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Lets an MCP client read what this window is showing — adapters, traffic, rules, the dashboard graph — and set filters or switch tabs for you. It cannot create, change or delete firewall rules."/>

        <!-- Status + start/stop -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12"
                Background="{DynamicResource SecondaryBgBrush}" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BtnToggle" DockPanel.Dock="Right" Content="Start"
                        Click="OnToggleClick" Padding="20,6" MinWidth="90"
                        Style="{DynamicResource AccentButton}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Stopped" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="TxtStatusDetail" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Listening on 127.0.0.1 only, and off until you start it."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connection details -->
        <StackPanel x:Name="PanelDetails" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Run this once to register the server with Claude Code:"
                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>

            <TextBox x:Name="TxtCommand" Margin="0,6,0,0" IsReadOnly="True"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                     Background="{DynamicResource SecondaryBgBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" Padding="8"/>

            <Button Content="Copy command" Click="OnCopyClick"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,5"/>

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="The token is generated fresh each time you start the server and is never saved to disk. Stopping the server, or closing WinFW Manager, invalidates it — you will need to re-register with the new command."/>
        </StackPanel>

        <Button Grid.Row="4" Content="Close" Click="OnCloseClick"
                HorizontalAlignment="Right" Padding="20,6" MinWidth="90" Margin="0,12,0,0"/>
    </Grid>
</Window>
