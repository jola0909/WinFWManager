<UserControl x:Class="WinFWManager.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinFWManager.Core.Models;assembly=WinFWManager.Core">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBgBrush}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load Log File..." Command="{Binding LoadFileCommand}" Padding="12,4" Margin="0,0,8,0"/>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                    <Run Text="{Binding LoadedFilePath, Mode=OneWay, TargetNullValue='No file loaded'}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Filter Row -->
        <Border Grid.Row="1" Background="{DynamicResource TertiaryBgBrush}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Src IP:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding FilterSourceIp, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                <TextBlock Text="Dst IP:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding FilterDestIp, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                <TextBlock Text="Protocol:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding FilterProtocol, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,0"/>
                <TextBlock Text="From:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <DatePicker SelectedDate="{Binding FilterStartDate}" Width="120" Margin="0,0,8,0"/>
                <TextBlock Text="To:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker SelectedDate="{Binding FilterEndDate}" Width="120"/>
            </StackPanel>
        </Border>

        <!-- Loading Progress -->
        <ProgressBar Grid.Row="2" Value="{Binding LoadProgress}" Maximum="100" Height="4"
                     VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Log DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding EventsView}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="{DynamicResource PrimaryBgBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  RowBackground="{DynamicResource PrimaryBgBrush}"
                  AlternatingRowBackground="{DynamicResource SecondaryBgBrush}"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  HeadersVisibility="Column"
                  Margin="0,4,0,0">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:TrafficAction.Allow}">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:TrafficAction.Block}">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:TrafficAction.Drop}">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="Source IP" Binding="{Binding SourceAddress}" Width="130"/>
                <DataGridTextColumn Header="Src Port" Binding="{Binding SourcePort}" Width="70"/>
                <DataGridTextColumn Header="Dest IP" Binding="{Binding DestinationAddress}" Width="130"/>
                <DataGridTextColumn Header="Dst Port" Binding="{Binding DestinationPort}" Width="70"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="60"/>
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Status -->
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBgBrush}" Padding="8,4">
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                <Run Text="Events: "/>
                <Run Text="{Binding EventCount, Mode=OneWay}"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
