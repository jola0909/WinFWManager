<Window x:Class="WinFWManager.Views.WfpAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block auditing" Height="520" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Block auditing" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Traffic capture can see that the firewall dropped a packet, but not which rule did it. Windows records the responsible filter only in Security audit events, and those are switched off by default. Turning this on lets WinFW Manager name the rule behind a block."/>

        <!-- Status + toggle -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12"
                Background="{DynamicResource SecondaryBgBrush}" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BtnToggle" DockPanel.Dock="Right" Content="Enable"
                        Click="OnToggleClick" Padding="20,6" MinWidth="100"
                        Style="{DynamicResource AccentButton}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Checking…" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="TxtStatusDetail" FontSize="11" Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- What it actually changes -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="What this changes on your system" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="• Enables failure auditing for two Windows audit subcategories — Filtering Platform Packet Drop and Filtering Platform Connection. This is a system-wide security setting, not a setting of this app, and it stays on after you close WinFW Manager until you turn it off here."/>

            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="• Blocked packets and connections are then written to the Security event log. Only failures are audited; successes are never enabled, as those would record every permitted connection and fill the log."/>

            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="• Expect volume. A machine that is dropping traffic steadily can write thousands of events an hour, which ages other Security log entries out sooner. Turn it on while investigating, off afterwards."/>

            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="• If your audit policy is managed by Group Policy, a change made here may be reverted the next time policy refreshes."/>
        </StackPanel>

        <Button Grid.Row="4" Content="Close" Click="OnCloseClick"
                HorizontalAlignment="Right" Padding="20,6" MinWidth="90" Margin="0,12,0,0"/>
    </Grid>
</Window>
