<UserControl x:Class="WinFWManager.Views.NetworkInterfacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WinFWManager.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBgBrush}" Padding="8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,4"/>
        </Border>

        <!-- Adapter List -->
        <ListView Grid.Row="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                  Background="{DynamicResource PrimaryBgBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" Margin="4" CornerRadius="4"
                            Background="{DynamicResource SecondaryBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Name + Type Badge -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                <Border CornerRadius="3" Padding="6,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TertiaryBgBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AdapterType}" Value="WSL">
                                                    <Setter Property="Background" Value="#44FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AdapterType}" Value="HyperV">
                                                    <Setter Property="Background" Value="#4442A5F5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AdapterType}" Value="VSwitch">
                                                    <Setter Property="Background" Value="#444A9EFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AdapterType}" FontSize="10"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}"
                                       VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Up">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Details -->
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                                <Run Text="Alias: "/><Run Text="{Binding InterfaceAlias, Mode=OneWay}"/>
                                <Run Text="  |  MAC: "/><Run Text="{Binding MacAddress, Mode=OneWay, TargetNullValue='N/A'}"/>
                                <Run Text="  |  Profile: "/><Run Text="{Binding AssignedProfile, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- IP Addresses -->
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                                <Run Text="IPs: "/>
                                <Run Text="{Binding IpAddresses, Mode=OneWay, Converter={x:Static converters:IpListConverter.Instance}}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
