<UserControl x:Class="WinFWManager.Views.AuditBlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBgBrush}" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="&#x21BB;  Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{DynamicResource AccentButton}" Padding="16,6" FontSize="13"/>

                <Button DockPanel.Dock="Left" Content="Export CSV"
                        Command="{Binding ExportCsvCommand}" Margin="8,0,0,0"
                        ToolTip="Save the rows currently visible, with the filter applied."/>

                <TextBlock DockPanel.Dock="Right" Text="Loading…" Margin="8,0,0,0"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="240" VerticalAlignment="Center"
                             ToolTip="Matches application, rule/filter name, addresses, protocol or direction"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding BlocksView}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource PrimaryBgBrush}"
                  RowBackground="{DynamicResource PrimaryBgBrush}"
                  AlternatingRowBackground="{DynamicResource SecondaryBgBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                <DataGridTextColumn Header="Blocked by" Binding="{Binding Filter}" Width="230"/>
                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="170"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="170"/>
                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="150"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource SecondaryBgBrush}" Padding="8,6">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>
    </Grid>
</UserControl>
